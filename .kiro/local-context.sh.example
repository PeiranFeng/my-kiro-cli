#!/bin/bash
# 本机配置模板。复制为 .kiro/local-context.sh 并按本机实际值修改。
# local-context.sh 不纳入版本控制（见 .gitignore）。
# 用途：集中定义机器相关变量，实验/测试命令运行前读取，避免硬编码。
# 见 .kiro/steering/50-project-facts.md#local-context。

# conda 环境名
CONDA_ENV=<your-conda-env-name>

# preprocess_evaluate 本地 Snowflake 相关测试（snowflake.snowpark 等）的 conda 环境名
CONDA_ENV_SNOWFLAKE=<your-conda-env-name>

# snow CLI 连接名（定义见 ~/.config/snowflake/config.toml）
SNOWFLAKE_CONNECTION=<your-snow-connection-name>

# dbt 本机 CLI 连接 Snowflake 用（feature-lab 仓库 profiles.yml 的 env_var()，与上面的 snow CLI 连接是两套独立凭据）
SNOWFLAKE_ACCOUNT=<your-snowflake-account-identifier>
SNOWFLAKE_USER=<your-snowflake-username>
SNOWFLAKE_PASSWORD=<your-snowflake-password>
